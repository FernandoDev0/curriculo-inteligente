# Copie para .env e ajuste. Nao coloque chave real neste arquivo.
# O .env nao entra no Git.

POSTGRES_DB=curriculo
POSTGRES_USER=curriculo
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_PORT=5432

# JDBC usa as variaveis acima. Senha so no ambiente, nunca no codigo.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/curriculo
SPRING_DATASOURCE_USERNAME=curriculo
SPRING_DATASOURCE_PASSWORD=troque-esta-senha-local

# Opcao A da chave. Se vazia, use o assistente da aplicacao (opcao B).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Deixe vazio para desligar edicao de foto. So preencha com um modelo que edite imagem.
GEMINI_IMAGE_MODEL=

SERVER_PORT=8080
